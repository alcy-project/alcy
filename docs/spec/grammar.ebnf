(* alcy grammar, EBNF transcription.
 *
 * A living document: it follows the parser, not the other way around.
 * Changing the grammar means changing this file in the same commit.
 * Transcribed from docs/spec/grammar.md, docs/spec/keywords.md, and
 * the comp annotation sites in docs/spec/comp.md.
 *
 * Notation: ISO/IEC 14977 EBNF. `=` defines, `|` alternates, `[ ]`
 * is optional, `{ }` repeats zero or more, `( )` groups, `"x"` is a
 * literal token, `(* *)` is a comment. Lowercase names are syntactic;
 * UPPER names are lexical and only sketched at the end.
 *
 * What EBNF cannot say lives in trailing comments: longest-match
 * lexing, significant newlines, the nesting budget, and the three
 * disambiguations (struct literal vs block, `..` after a literal,
 * closure against parenthesized expressions). See
 * docs/spec/grammar.md for those rules.
 *)

file        = { item } ;

(* Items *)

item        = [ vis ] , ( fn_item | intrinsic_fn_item | extern_item
                        | struct_item | enum_item | impl_item
                        | spec_item | static_item | const_item | use_item ) ;
vis         = "pub" ;
fn_item     = [ "unsafe" ] , [ "comp" ] , "fn" , IDENT , [ type_params ] , "(" , [ params ] , ")"
            , [ "->" , type ] , block ;
              (* An `unsafe fn` hands its callers an operation that
                 needs the gate; the body is not one implicitly. A
                 `comp fn` is called during compilation only. At most
                 one of the two markers may appear, whichever order it
                 is written in; their meaning together is not settled
                 yet. See docs/spec/ffi.md and docs/spec/comp.md. *)
intrinsic_fn_item = [ "unsafe" ] , "intrinsic" , "fn" , IDENT , [ type_params ] ,
            "(" , [ params ] , ")" , [ "->" , type ] , ";" ;
              (* A signature with no body, terminated by `;`. The
                 precondition-carrying intrinsics say `unsafe`, which
                 the checker verifies. See docs/spec/items.md,
                 "Intrinsic declarations". *)
extern_item = "extern" , STRING , "{" , { extern_fn } , "}" ;
extern_fn   = "fn" , IDENT , [ type_params ] , "(" , [ params ] , ")"
            , [ "->" , type ] , ";" ;
              (* Bodyless declarations whose names are the symbols the
                 linker resolves; only "C" is accepted, and calling
                 one needs the gate. See docs/spec/ffi.md. *)
type_params = "<" , IDENT , { "," , IDENT } , ">" ;
params      = [ [ "comp" ] , pattern , ":" , type ,
                { "," , [ "comp" ] , pattern , ":" , type } , [ "," ] ] ;
              (* "comp" marks a compile-time parameter; plain functions
                 use the same shape without it. See docs/spec/comp.md. *)
struct_item = "struct" , IDENT , [ type_params ] , "{"
            , field , { "," , field } , [ "," ] , "}" ;
field       = IDENT , ":" , type ;
enum_item   = "enum" , IDENT , [ type_params ] , "{"
            , variant , { "," , variant } , [ "," ] , "}" ;
variant     = IDENT | IDENT , "(" , [ type , { "," , type } ] , ")" ;
impl_item   = "impl" , [ type_params ] , type , [ "for" , type ] , "{"
            , { [ "pub" ] , fn_item } , "}" ;
              (* Without "for" the block is inherent. With it the first
                 type is the implemented spec as a path, optionally with
                 arguments, and the second is the target. *)
spec_item   = "spec" , IDENT , [ type_params ] , [ ":" , path_type ] , "{"
            , { [ vis ] , spec_method } , "}" ;
              (* The optional path names a super-spec: every
                 implementation of this spec then also requires an
                 implementation of the super for the same target, and
                 the chain must not cycle. Generic super-specs are not
                 supported yet. See
                 docs/adr/0053-operators-are-sealed-specs.md. *)
spec_method = [ "unsafe" ] , "fn" , IDENT , [ type_params ] , "(" , [ params ] , ")"
            , [ "->" , type ] , ";" ;
              (* Signatures only: a body here is an error, and every
                 implementation supplies each declared method. An
                 `unsafe` method marker parses and is refused for
                 now; see docs/spec/ffi.md. *)
static_item = "static" , IDENT , ":" , type , "=" , expr ;
const_item  = "const" , IDENT , ":" , type , "=" , expr ;
use_item    = "use" , path , [ "as" , IDENT ] , ";" ;

(* Types *)

type        = primitive | "()" | "!" | "str"
            | tuple_type | paren_type | array_type | slice_type
            | ref_type | raw_ptr_type | path_type | func_type ;
primitive   = integer_type | float_type | "bool" ;
tuple_type  = "(" , type , "," , [ type , { "," , type } ] , [ "," ] , ")" ;
              (* The comma is what makes the parens a type of their own:
                 `(A)` is `A`, and `(A,)` is the one-element tuple. *)
paren_type  = "(" , type , ")" ;
func_type   = "(" , [ type , { "," , type } , [ "," ] ] , ")" ,
              "->" , type ;
              (* Structural: two closures over one signature share the
                 type, and captures are erased. A single type in
                 parens is one parameter, so `(A) -> R` is a function
                 type while a bare `(A)` is `A`. *)
array_type  = "[" , type , ";" , INTEGER , "]" ;
slice_type  = "[" , type , "]" ;
ref_type    = "&" , [ "mut" ] , type ;
raw_ptr_type = "*" , [ "mut" ] , type ;
              (* Thin and Copy, outside the region system. `**T` lexes
                 as the power token, so the pair is read as two stars
                 in a type position; see docs/spec/ffi.md. *)
path_type   = path , [ "<" , type , { "," , type } , ">" ] ;

(* Patterns *)

pattern     = "_" | IDENT | "mut" , IDENT | literal
            | "-" , literal
            | path , "(" , [ pattern , { "," , pattern } ] , ")"
            | path , "{" , field_pat , { "," , field_pat } , "}"
            | "&" , [ "mut" ] , pattern
            | pattern , "|" , pattern ;
field_pat   = IDENT | IDENT , ":" , pattern ;

(* Expressions, lowest to highest precedence *)

expr          = range_expr ;
range_expr    = [ or_expr ] , range_op , [ or_expr ] ;
range_op      = ".." | "..=" | "..<" ;
              (* A range naming an end says whether the end is included:
                 only "..=" (inclusive) and "..<" (exclusive) may be
                 followed by an endpoint. A bare ".." is the unbounded
                 spelling, and a start endpoint is always included. *)
or_expr       = and_expr , { "||" , and_expr } ;
and_expr      = cmp_expr , { "&&" , cmp_expr } ;
cmp_expr      = bit_or_expr , [ ( "==" | "!=" | ">" | "<" | ">=" | "<=" ) ,
                                bit_or_expr ] ;
bit_or_expr   = bit_xor_expr , { "|" , bit_xor_expr } ;
bit_xor_expr  = bit_and_expr , { "^" , bit_and_expr } ;
bit_and_expr  = shift_expr , { "&" , shift_expr } ;
shift_expr    = add_expr , { ( "<<" | ">>" ) , add_expr } ;
add_expr      = mul_expr , { ( "+" | "-" ) , mul_expr } ;
mul_expr      = pow_expr , { ( "*" | "/" | "%" ) , pow_expr } ;
pow_expr      = cast_expr , [ "**" , pow_expr ] ;
cast_expr     = unary_expr , [ "as" , type ] ;
unary_expr    = ( "-" | "!" | "~" | "&" , [ "mut" ] | "*" ) , unary_expr ;
              (* `**p` lexes as the power token, but a binary `**`
                 needs a left operand, so in prefix position the pair
                 is two dereferences. *)
question_expr = postfix_expr , [ "?" ] ;
postfix_expr  = primary , { call | field | method | index | "?" } ;
call          = [ turbofish ] , "(" , [ expr , { "," , expr } ] , ")" ;
turbofish     = "::" , "<" , type , { "," , type } , ">" ;
field         = "." , ( IDENT | INTEGER ) ;
method        = "." , IDENT , "(" , [ expr , { "," , expr } ] , ")" ;
index         = "[" , expr , "]" ;
primary       = literal | path | struct_expr | tuple_expr | array_expr
              | paren_expr | block_like | comp_block | unsafe_block
              | closure_expr | ret_expr | break_expr | continue_expr ;
              (* `?` is a postfix operator, so it may be followed by a
                 field or method access: `f()?.x` reads as `(f()?).x`.
                 See docs/spec/grammar.md, "Expressions". *)
closure_expr  = [ captures ] , "(" , [ closure_param ,
                  { "," , closure_param } , [ "," ] ] , ")" ,
                  "->" , expr ;
closure_param = [ "mut" ] , ( IDENT | "_" ) , [ ":" , type ] ;
captures      = "[" , [ capture , { "," , capture } , [ "," ] ] , "]" ;
capture       = [ "&" , [ "mut" ] ] , capture_name ;
capture_name  = IDENT | "self" ;
              (* A bare name captures by value (a move, or a copy for a
                 Copy type); `&name` borrows shared and `&mut name`
                 borrows exclusively. A bare parameter list captures
                 nothing; `[]` says the same thing explicitly.
                 Captures name locals only. *)
ret_expr      = "ret" , [ expr ] ;
break_expr    = "break" ;
continue_expr = "continue" ;
paren_expr    = "(" , expr , ")" ;
struct_expr   = path , "{" , field_init , { "," , field_init } ,
                [ "," ] , [ ".." , expr ] , "}" ;
field_init    = IDENT , ":" , expr ;
tuple_expr    = "(" , expr , "," , expr , { "," , expr } , [ "," ] , ")"
              | "(" , ")" ;
array_expr    = "[" , expr , { "," , expr } , [ "," ] , "]"
              | "[" , expr , ";" , INTEGER , "]" ;
block_like    = block | if_expr | match_expr | loop_expr | while_expr
              | for_expr ;
comp_block    = "comp" , block ;
unsafe_block  = "unsafe" , block ;
              (* Opens the gate for the operations inside; its value
                 is the block's. The rule is lexical: an operation
                 the gate covers may appear only inside such a block.
                 See docs/spec/ffi.md. *)

(* Statements and blocks *)

block       = "{" , { statement } , [ expr ] , "}" ;
statement   = decl_stmt | reassign_stmt | expr_stmt ;
decl_stmt   = [ "const" ] , pattern , [ ":" , type ] , ":=" , expr ;
              (* `mut` in declaration position folds into the pattern
                 (`mut` ident); `const` is the one decl-level modifier,
                 and its initializer is a compile-time value. *)
reassign_stmt = expr , assign_op , expr ;
assign_op     = "=" | "+=" | "-=" | "*=" | "/=" | "%=" | "**=" | "&="
              | "|=" | "^=" | "<<=" | ">>=" ;
              (* The left side is read as an ordinary expression; whether
                 it names a place is decided after parsing, so `g() = 1`
                 is a diagnostic about the place rather than a syntax
                 error. See docs/spec/grammar.md, "Statements". *)
expr_stmt   = expr ;
if_expr     = "if" , ( expr | pattern , ":=" , expr ) , block ,
              [ "else" , ( if_expr | block ) ] ;
while_expr  = "while" , ( expr | pattern , ":=" , expr ) , block ;
loop_expr   = "loop" , block ;
for_expr    = "for" , pattern , "in" , expr , block ;
match_expr  = "match" , expr , "{" , { match_arm , [ ( "," | ";" ) ] } , "}" ;
match_arm   = pattern , "=>" , expr ;

(* Modules and paths *)

path = ( "package" | "self" | "super" | DEP | IDENT ) , { "::" , IDENT } ;

(* Lexical appendix (sketch only) *)

IDENT     = ( ALPHA | "_" ) , { ALPHA | DIGIT | "_" } ;
              (* A lone `_` is the wildcard token, never an identifier. *)
INTEGER   = DIGIT , { DIGIT | "_" } , [ TYPE_SUFFIX ]
          | ( "0b" | "0o" | "0x" ) , DIGIT , { DIGIT | "_" } ,
            [ TYPE_SUFFIX ] ;
FLOAT     = DIGIT , { DIGIT | "_" } , "." , DIGIT , { DIGIT | "_" } ,
            [ EXPONENT ] , [ TYPE_SUFFIX ]
          | DIGIT , { DIGIT | "_" } , EXPONENT , [ TYPE_SUFFIX ] ;
EXPONENT   = ( "e" | "E" ) , [ "+" | "-" ] , DIGIT , { DIGIT | "_" } ;
STRING    = '"' , { STRING_CHAR | ESCAPE } , '"' ;
ESCAPE    = "\n" | "\t" | "\r" | "\\" | '\"' | "\0" | "\u{" , HEXDIGIT ,
            { HEXDIGIT } , "}" ;
CHAR      = "'" , ( CHAR_CHAR | ESCAPE ) , "'" ;
LINE_COMMENT  = "//" , { ANY_BUT_NEWLINE } ;
BLOCK_COMMENT = "/*" , { ANY | BLOCK_COMMENT } , "*/" ;
DOC_COMMENT   = "///" , { ANY_BUT_NEWLINE } ;

(* Keywords: fn intrinsic extern struct enum impl spec static pub const
 *   mut unsafe use
 *   if else loop while for in break continue ret match
 *   package self super Self as
 *   i8 i16 i32 i64 isize u8 u16 u32 u64 usize f32 f64 bool str
 * Reserved: async await union register where dyn
 *   i128 u128
 * Contextual, and a keyword rather than a reserved word because it only
 *   has a meaning in one position: `comp` in signatures, function items,
 *   and blocks; `intrinsic` in item position; `spec` in item position;
 *   `for` in a loop head and in an `impl` header; `in` in a `for` head.
 *   Using one outside its position is an ordinary parse error rather
 *   than a reserved-name diagnostic. See docs/spec/keywords.md.
 *
 * Nesting is bounded at 256 levels on expressions, types, blocks,
 * patterns, and items alike; exceeding it reports E3004/E4050/E5005.
 * Newlines are significant outside brackets (lexed as `;` after a
 * statement-ending token, with continuation positions); block openers
 * stay on their header line. `1..<2` lexes as range, never float.
 * `match`/`if`/`while` conditions, `for` heads, and `else` never open
 * a struct literal: `{` after them always opens the body block. A
 * `for` head never reads a block as a range end either.
 *)
