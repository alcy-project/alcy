source_set("source") {
  sources = [
    "source.cc",
    "source.h",
  ]

  # NOTE: must not depend on //compiler/diag (diag spans reference FileIds
  # minted here; the reverse edge would be a dependency cycle). The fetch
  # adapter lives in //compiler/pipeline instead.
  deps = [ "//compiler:base_modules" ]
  configs += [ "//compiler:alcy_config" ]
}
