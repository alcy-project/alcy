executable("tests") {
  sources = [
    "analyzer/resolve_modules_test.cc",
    "analyzer/types_test.cc",
    "ast/ast_test.cc",
    "ast/node_vec_test.cc",
    "ast/verify_test.cc",
    "base/for_each_test.cc",
    "base/process_memory_test.cc",
    "benchmarks/engine_test.cc",
    "benchmarks/generator_test.cc",
    "borrow/borrow_test.cc",
    "cli/cli_config_test.cc",
    "cli/cli_main_test.cc",
    "cli/logger_test.cc",
    "cli/output_test.cc",
    "cli/parse_args_test.cc",
    "cli/parse_output_test.cc",
    "cli/suggest_test.cc",
    "cli/trace_report_test.cc",
    "cli/validate_test.cc",
    "codegen/backend_test.cc",
    "codegen/wasm_module_test.cc",
    "codegen/wasm_reach_test.cc",
    "codegen/wasm_writer_test.cc",
    "codegen_llvm/llvm_ir_emitter_test.cc",
    "codegen_llvm/runtime_ir_test.cc",
    "diag/bag_test.cc",
    "diag/render_test.cc",
    "i18n/i18n_test.cc",
    "ir/ir_common_test.cc",
    "ir/storage_builder_test.cc",
    "ir/type_layout_test.cc",
    "ir/verifier_test.cc",
    "lexer/lexer_test.cc",
    "lexer/token_test.cc",
    "lowering/lowering_test.cc",
    "parser/desugar_test.cc",
    "parser/parser_test.cc",
    "path/path_test.cc",
    "pipeline/api_test.cc",
    "pipeline/check_test.cc",
    "pipeline/dependencies_test.cc",
    "pipeline/emit_mode_test.cc",
    "pipeline/hostile_input_test.cc",
    "pipeline/modules_test.cc",
    "pipeline/nesting_test.cc",
    "pipeline/new_test.cc",
    "pipeline/parse_test.cc",
    "pipeline/pipeline_test.cc",
    "pipeline/spawn_test.cc",
    "pipeline/std_select_test.cc",
    "pipeline/std_stage_test.cc",
    "pkg/manifest_test.cc",
    "pkg/toolchain_test.cc",
    "playground/playground_test.cc",
    "property/mangle_property_test.cc",
    "source/source_test.cc",
    "source/virtual_source_test.cc",
    "symbol/mangle_test.cc",
    "test_main.cc",
    "text/unescape_test.cc",
    "util/add_sources_test.cc",
    "util/test_util.cc",
    "util/test_util.h",
    "util/virtual_source.cc",
    "util/virtual_source.h",
  ]

  configs += [
    "//compiler:alcy_config",
    "//compiler:win_sys_libs",
  ]

  # doctest forward-declares std::ostream by default, which MSVC's
  # string_view operator<< cannot instantiate; including the real headers
  # fixes Windows builds (see doctest configuration.md). Must be global:
  # every TU including doctest needs it before the first include.
  defines = [ "DOCTEST_CONFIG_USE_STD_HEADERS" ]

  deps = [
    "//compiler:alcy_lib",
    "//compiler/benchmarks:bench",
    "//compiler/benchmarks:bench_cases",
    "//compiler/cli",
    "//third_party/doctest",

    # A property test parses what a serializer wrote, which is the only
    # way to state "the output is loadable" without a second reader.
    "//third_party/toml",
  ]
}
