declare_args() {
  # The backend implementations compiled into the compiler. "llvm" brings
  # the prebuilt LLVM, and on native Linux the embedded ELF linker with
  # it; "direct-wasm" is alcy's own emitter, which needs neither. A build
  # with no backend still checks.
  alcy_backends = [ "llvm" ]
}

alcy_use_llvm = filter_include(alcy_backends, [ "llvm" ]) != []
alcy_direct_wasm = filter_include(alcy_backends, [ "direct-wasm" ]) != []
