import("//compiler/backends.gni")

group("alcy") {
  deps = [
    ":libs",
    "cli:alcy",
  ]
}

config("alcy_config") {
  include_dirs = [ "//compiler" ]

  # Which backends this build carries, as `codegen::backend_available`
  # reads them. A backend that was not compiled in has no code to run, so
  # the answer has to be a build-time fact rather than a runtime one.
  if (alcy_use_llvm) {
    defines = [ "ALCY_BACKEND_LLVM=1" ]
  } else {
    defines = [ "ALCY_BACKEND_LLVM=0" ]
  }
  if (alcy_direct_wasm) {
    defines += [ "ALCY_BACKEND_DIRECT_WASM=1" ]
  } else {
    defines += [ "ALCY_BACKEND_DIRECT_WASM=0" ]
  }
}

group("base_modules") {
  public_deps = [
    "base",
    "config",
    "debug",
    "//third_party/fpag",
  ]
}

group("modules") {
  public_deps = [
    ":base_modules",
    "analyzer",
    "ast",
    "borrow",
    "codegen",
    "diag",
    "i18n",
    "ir",
    "lexer",
    "lowering",
    "parser",
    "path",
    "pkg",
    "source",
    "symbol",
    "text",
  ]
  if (alcy_use_llvm) {
    public_deps += [ "codegen_llvm" ]
  }
}

group("libs") {
  public_deps = [
    ":base_modules",
    ":modules",
    "pipeline",
  ]
}

# Single static library archiving every compiler module. Executables link
# only against this target, so CI and releases can ship the archive itself
# (native libalcy.a / alcy.lib, wasm libalcy.a for the playground).
static_library("alcy_lib") {
  output_name = "alcy"
  output_dir = root_out_dir
  complete_static_lib = true
  public_deps = [ ":libs" ]
}

config("win_sys_libs") {
  if (is_win) {
    libs = [
      "dbghelp",
      "onecore",
      "ntdll",

      # GetProcessMemoryInfo, for the peak memory on a result line.
      "psapi",
    ]
  }
}
