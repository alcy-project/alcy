source_set("codegen_llvm") {
  sources = [
    "common.cc",
    "common.h",
    "declaration.cc",
    "declaration.h",
    "llvm_backend.cc",
    "llvm_backend.h",
    "llvm_ir_emitter.cc",
    "llvm_ir_emitter.h",
    "llvm_ir_emitter_compute.cc",
    "llvm_ir_emitter_memory.cc",
    "llvm_ir_storage.cc",
    "llvm_ir_storage.h",
    "runtime_ir.cc",
    "runtime_ir.h",
    "target.cc",
    "target.h",
  ]

  # `ir` is public because the emitter's header names ir types; `symbol`
  # is not, because only the .cc mangles a name.
  deps = [
    "//compiler:base_modules",
    "//compiler/symbol",
  ]
  public_deps = [
    "//compiler/ir",
    "//third_party/llvm",
  ]

  configs += [ "//compiler:alcy_config" ]
}
