[submodule "third_party/doctest/src"]
	path = third_party/doctest/src
	url = https://github.com/doctest/doctest
[submodule "third_party/fmt/src"]
	path = third_party/fmt/src
	url = https://github.com/fmtlib/fmt
[submodule "third_party/xxhash/src"]
	path = third_party/xxhash/src
