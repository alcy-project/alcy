# The tree's formatting answers first, then the staged source files get
# the lint checks. A clone without uv has no way to run either; say so
# rather than blocking the commit.
if ! command -v uv >/dev/null 2>&1; then
  echo "pre-commit: uv not found; skipping tree checks" >&2
  exit 0
fi

uv run ./tools/format.py --dry-run || exit $?
exec uv run ./tools/lint.py --staged
