project_name = "alcy"
project_version = "0.1.0"
command_about = "alcy compiler"

if (target_os == "") {
  target_os = host_os
}

if (target_cpu == "") {
  if (target_os == "android") {
    target_cpu = "arm64"
  } else if (target_os == "emscripten") {
    target_cpu = "wasm32"
  } else {
    target_cpu = host_cpu
  }
}

if (current_cpu == "") {
  current_cpu = target_cpu
}
if (current_os == "") {
  current_os = target_os
}

is_android = current_os == "android"
is_chromeos = current_os == "chromeos"
is_fuchsia = current_os == "fuchsia"
is_ios = current_os == "ios"
is_linux = current_os == "linux"
is_mac = current_os == "mac"
is_wasm = current_os == "emscripten"
is_watchos = current_os == "watchos"
is_win = current_os == "win" || current_os == "winuwp"

is_apple = is_ios || is_mac || is_watchos
is_posix = !is_win && !is_fuchsia

declare_args() {
  is_clang = true
}

is_msvc = is_win && !is_clang

declare_args() {
  is_debug = true
}

declare_args() {
  use_lld = true
}

if (!is_win && !is_mac && !is_ios) {
  declare_args() {
    use_mold =
        # --ld-path is a clang-only flag.
        is_clang && (current_os == "android" || current_os == "linux") &&
        (current_cpu == "x64" || current_cpu == "arm64" ||
         current_cpu == "x86" || current_cpu == "arm")
  }
}
use_mold = defined(use_mold) && use_mold

if (current_os == "linux") {
  if (current_cpu == "x64") {
    if (is_clang) {
      set_default_toolchain("//build/toolchains/linux:clang_x64")
    } else {
      set_default_toolchain("//build/toolchains/linux:x64")
    }
  } else if (current_cpu == "arm64") {
    if (is_clang) {
      set_default_toolchain("//build/toolchains/linux:clang_arm64")
    } else {
      set_default_toolchain("//build/toolchains/linux:arm64")
    }
  } else if (current_cpu == "x86") {
    if (is_clang) {
      set_default_toolchain("//build/toolchains/linux:clang_x86")
    } else {
      set_default_toolchain("//build/toolchains/linux:x86")
    }
  } else if (current_cpu == "arm") {
    if (is_clang) {
      set_default_toolchain("//build/toolchains/linux:clang_arm")
    } else {
      set_default_toolchain("//build/toolchains/linux:arm")
    }
  } else if (current_cpu == "riscv64") {
    if (is_clang) {
      set_default_toolchain("//build/toolchains/linux:clang_riscv64")
    } else {
      set_default_toolchain("//build/toolchains/linux:riscv64")
    }
  } else {
    if (is_clang) {
      set_default_toolchain("//build/toolchains/linux:clang_x64")
    } else {
      set_default_toolchain("//build/toolchains/linux:x64")
    }
  }
} else if (current_os == "mac") {
  if (current_cpu == "arm64") {
    set_default_toolchain("//build/toolchains/mac:clang_arm64")
  } else {
    set_default_toolchain("//build/toolchains/mac:clang_x64")
  }
} else if (is_win) {
  if (is_clang) {
    set_default_toolchain("//build/toolchains/windows:clang_x64")
  } else {
    if (current_cpu == "x86") {
      set_default_toolchain("//build/toolchains/windows:msvc_x86")
    } else {
      set_default_toolchain("//build/toolchains/windows:msvc_x64")
    }
  }
} else if (current_os == "emscripten") {
  set_default_toolchain("//build/toolchains/wasm:emcc_wasm32")
} else {
  set_default_toolchain("//build/toolchains/linux:clang_x64")
}

default_compiler_configs = [
  "//build/config/compiler:compiler",
  "//build/config/compiler:default_flags",
  "//build/config/compiler:linker",
]

# Emscripten ships its own libc++; the libcxx config would conflict with it.
if (!is_win && !is_wasm) {
  default_compiler_configs += [ "//build/config/compiler:libcxx" ]
}

# AddressSanitizer under Emscripten needs its own runtime setup; keep the
# wasm build minimal until playground work needs it.
if (is_wasm) {
  default_compiler_configs += [ "//build/config/compiler:emscripten" ]
}

if (is_debug) {
  default_compiler_configs += [ "//build/config/compiler:debug" ]

  if (!is_win && !is_wasm) {
    default_compiler_configs += [ "//build/config/compiler:asan" ]
  }
} else {
  default_compiler_configs += [ "//build/config/compiler:release" ]
}

default_configs =
    default_compiler_configs + [ "//build/config/compiler:default_warnings" ]
default_third_party_configs = default_compiler_configs

default_executable_configs = default_configs
default_shared_library_configs = default_configs
default_static_library_configs = default_configs
default_source_set_configs = default_configs

set_defaults("executable") {
  configs = default_executable_configs
}

set_defaults("shared_library") {
  configs = default_shared_library_configs
}

set_defaults("static_library") {
  configs = default_static_library_configs
}

set_defaults("source_set") {
  configs = default_source_set_configs
}
