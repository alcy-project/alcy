config("compiler") {
  asmflags = []
  cflags = []
  cflags_c = []
  cflags_cc = []
  cflags_objc = []
  cflags_objcc = []
  rustenv = []
  rustflags = []
  ldflags = []
  defines = []

  c_version = "11"
  cxx_version = "20"

  cflags += [ "-fdiagnostics-color=always" ]

  if (is_linux || is_chromeos || is_android || current_os == "aix") {
    if (is_clang) {
      standard_prefix = "c"

      # Since we build with -std=c* and not -std=gnu*, _GNU_SOURCE will not be
      # defined by the compiler.  However, lots of code relies on the
      # non-standard features that _GNU_SOURCE enables, so define it manually.
      defines += [ "_GNU_SOURCE" ]
    } else {
      # Gcc does not support ##__VA_ARGS__ when in standards-conforming mode,
      standard_prefix = "gnu"
    }

    cflags_c += [ "-std=${standard_prefix}${c_version}" ]
    cflags_cc += [ "-std=${standard_prefix}++${cxx_version}" ]
  } else if (is_win) {
    defines += [
      "_MT",

      # "_DLL",
      "NOMINMAX",

      # MSVC deprecates standard C calls (fopen etc.) as "unsafe"; the
      # _s-suffixed replacements are MSVC-only, so silence the warning
      # project-wide like Chromium and LLVM do instead of ifdeffing call sites.
      "_CRT_SECURE_NO_WARNINGS",
    ]

    if (is_clang) {
      cflags_c += [ "-std=c${c_version}" ]
      cflags_cc += [ "-std=c++${cxx_version}" ]

      if (is_debug) {
        cflags += [ "-fms-runtime-lib=static_debug" ]
        ldflags += [ "-fms-runtime-lib=static_debug" ]
      } else {
        cflags += [ "-fms-runtime-lib=static" ]
        ldflags += [ "-fms-runtime-lib=static" ]
      }
    } else {
      cflags_c += [ "/std:c${c_version}" ]
      cflags_cc += [ "/std:c++${cxx_version}" ]

      if (is_debug) {
        cflags += [ "/MTd" ]
      } else {
        cflags += [ "/MT" ]
      }

      # Required for the __cplusplus macro definition to match the C++ version
      # on MSVC. clang-cl defines it by default and doesn't need this flag.
      # See: https://learn.microsoft.com/en-us/cpp/build/reference/zc-cplusplus
      cflags_cc += [ "/Zc:__cplusplus" ]
    }
  } else {
    cflags_c += [ "-std=c${c_version}" ]
    cflags_cc += [ "-std=c++${cxx_version}" ]
  }
}

config("default_flags") {
  cflags = [ "-fno-exceptions" ]
}

config("default_warnings") {
  cflags = [
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Werror",
  ]
}

config("linker") {
  ldflags = []

  # if (linker_path != "") {
  #   inputs = [ linker_path ]
  #   ldflags += [ "--ld-path=" + rebase_path(linker_path, root_build_dir) ]
  # } else if (use_lld) {
  # emcc drives wasm-ld itself; -fuse-ld=lld is not accepted there.
  if (use_lld && !is_wasm) {
    ldflags += [ "-fuse-ld=lld" ]
    # if (lld_path != "") {
    #   ldflags += [ "-B" + rebase_path(lld_path, root_build_dir) ]
    # }
  }
  if (is_win && is_debug) {
    # Workaround: clang's -fms-runtime-lib=*_debug still selects the release
    # CRT (libcmt.lib) instead of the debug CRT (libcmtd.lib), leaving the
    # debug CRT symbols (_malloc_dbg etc.) unresolved. Force the debug CRT
    # explicitly. The C++ debug library (libcpmtd.lib) is already pulled in
    # via the MSVC headers' #pragma comment(lib) directives.
    ldflags += [
      "-Xlinker",
      "/NODEFAULTLIB:libcmt.lib",
      "-Xlinker",
      "/DEFAULTLIB:libcmtd.lib",
    ]
  }
  if (is_mac) {
    ldflags += [
      "-Wl,-rpath,@executable_path",
      "-Wl,-rpath,@executable_path/lib",
    ]
  } else if (!is_win && !is_wasm) {
    ldflags += [
      "-Wl,-rpath=\$ORIGIN",
      "-Wl,-rpath=\$ORIGIN/lib",
    ]
  }
}

config("emscripten") {
  # Keep in sync with the project-wide -fno-exceptions policy and make test
  # binaries runnable under node with a growable heap (StringPool reserves
  # address space up front on native builds; see S2 notes in the wasm plan).
  ldflags = [
    "-sWASM=1",
    "-sENVIRONMENT=node",
    "-sALLOW_MEMORY_GROWTH=1",
    "-sEXIT_RUNTIME=1",
    "-sDISABLE_EXCEPTION_CATCHING=1",
  ]
}

config("libcxx") {
  cflags = []
  cflags_cc = []
  ldflags = []
  include_dirs = []
  lib_dirs = []

  inc_dir = getenv("LIBCXX_INCLUDE_DIR")
  target_inc_dir = getenv("LIBCXX_TARGET_INCLUDE_DIR")
  lib_dir = getenv("LIBCXX_LIB_DIR")

  if (inc_dir == "") {
    inc_dir = "/usr/include/c++/v1"
  }
  if (inc_dir != "") {
    cflags_cc += [
      "-nostdinc++",
      "-isystem",
      rebase_path(inc_dir, root_build_dir),
    ]
  }

  if (target_inc_dir != "") {
    cflags_cc += [
      "-isystem",
      rebase_path(target_inc_dir, root_build_dir),
    ]
  }

  if (lib_dir != "") {
    cflags_cc += [ "-nostdlib++" ]
    lib_dirs += [ lib_dir ]
  }

  ldflags += [ "-stdlib=libc++" ]

  # Static linking flags and symbol groups are Linux/ELF specific.
  # macOS/ld64 handles library lookups automatically without -Bstatic/-Bdynamic.
  if (is_linux || is_chromeos) {
    ldflags += [
      "-static-libstdc++",
      "-Wl,-Bstatic",
      "-lc++",
      "-lc++abi",
      "-Wl,-Bdynamic",
    ]
  } else {
    ldflags += [
      "-lc++",
      "-lc++abi",
    ]
  }
}

config("asan") {
  cflags = [ "-fsanitize=address" ]
  ldflags = [ "-fsanitize=address" ]
}

config("debug") {
  defines = [ "_DEBUG" ]
  cflags = [
    "-g3",
    "-fno-omit-frame-pointer",
  ]

  if (is_win) {
    cflags += [ "-O0" ]
  } else {
    cflags += [ "-Og" ]
  }
}

config("release") {
  defines = [ "NDEBUG" ]
  cflags = [
    "-g0",
    "-O3",
    "-fomit-frame-pointer",
  ]
  if (!is_mac && !is_win && !is_wasm) {
    ldflags = [ "-Wl,--strip-all" ]
  }
}
