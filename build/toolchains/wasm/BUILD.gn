import("//build/toolchains/gcc_clang.gni")

# Emscripten toolchain targeting wasm32. Expects emcc/em++/emar on PATH
# (e.g. via emsdk). Produces .js wrappers with sidecar .wasm files.
clang_toolchain("emcc_wasm32") {
  cc = "emcc"
  cxx = "em++"
  ld = cxx
  ar = "emar"

  readelf = "llvm-readobj"
  nm = "llvm-nm"

  executable_extension = ".js"

  # The compiler under test needs room: a debug binary compiling to an
  # object already spends most of the default 64 KiB, so any standard
  # library growth tips it over. A megabyte is still nothing next to
  # the megabytes a native test host grants the same binary.
  extra_ldflags = "-sSTACK_SIZE=1MB"

  toolchain_args = {
    current_cpu = "wasm32"
    current_os = "emscripten"
    is_clang = true
  }
}
