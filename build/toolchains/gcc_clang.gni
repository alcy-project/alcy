import("toolchain.gni")

template("gcc_clang") {
  toolchain(target_name) {
    assert(defined(invoker.ar), "gcc_clang() must specify a \"ar\" value")
    assert(defined(invoker.cc), "gcc_clang() must specify a \"cc\" value")
    assert(defined(invoker.cxx), "gcc_clang() must specify a \"cxx\" value")
    assert(defined(invoker.ld), "gcc_clang() must specify a \"ld\" value")
    assert(defined(invoker.is_clang),
           "gcc_clang() must specify a \"is_clang\" value")

    assert(defined(invoker.toolchain_args),
           "Toolchains must specify toolchain_args")
    invoker_toolchain_args = invoker.toolchain_args
    assert(defined(invoker_toolchain_args.current_cpu),
           "toolchain_args must specify a current_cpu")
    assert(defined(invoker_toolchain_args.current_os),
           "toolchain_args must specify a current_os")

    cc = invoker.cc
    cxx = invoker.cxx
    asm = invoker.cc
    ar = invoker.ar
    ld = invoker.ld
    is_clang = invoker_toolchain_args.is_clang

    if (defined(invoker.readelf)) {
      readelf = invoker.readelf
    } else {
      readelf = "readelf"
    }
    if (defined(invoker.nm)) {
      nm = invoker.nm
    } else {
      nm = "nm"
    }

    # -fmodule-name is not supported by gcc.
    module_name_flag = ""
    if (is_clang) {
      module_name_flag = " -fmodule-name=\"{{cc_module_name}}_private\""
    }

    # enable_linker_map = defined(invoker.enable_linker_map) &&
    #                     invoker.enable_linker_map

    if (defined(invoker.shlib_extension)) {
      default_shlib_extension = invoker.shlib_extension
    } else {
      default_shlib_extension = shlib_extension
    }
    if (defined(invoker.default_shlib_subdir)) {
      default_shlib_subdir = invoker.default_shlib_subdir
    } else {
      default_shlib_subdir = ""
    }
    if (defined(invoker.executable_extension)) {
      default_executable_extension = invoker.executable_extension
    } else {
      default_executable_extension = ""
    }

    if (defined(invoker.extra_cflags) && invoker.extra_cflags != "") {
      extra_cflags = " " + invoker.extra_cflags
    } else {
      extra_cflags = ""
    }
    if (defined(invoker.extra_cppflags) && invoker.extra_cppflags != "") {
      extra_cppflags = " " + invoker.extra_cppflags
    } else {
      extra_cppflags = ""
    }
    if (defined(invoker.extra_cxxflags) && invoker.extra_cxxflags != "") {
      extra_cxxflags = " " + invoker.extra_cxxflags
    } else {
      extra_cxxflags = ""
    }
    if (defined(invoker.extra_asmflags) && invoker.extra_asmflags != "") {
      extra_asmflags = " " + invoker.extra_asmflags
    } else {
      extra_asmflags = ""
    }
    if (defined(invoker.extra_ldflags) && invoker.extra_ldflags != "") {
      extra_ldflags = " " + invoker.extra_ldflags
    } else {
      extra_ldflags = ""
    }

    md = "-MMD"
    object_subdir = "{{target_out_dir}}/{{label_name}}"

    tool("cc") {
      output = "$object_subdir/{{source_name_part}}.o"
      depfile = "$output.d"
      precompiled_header_type = "gcc"

      command = "$cc $md -MF $depfile {{defines}} {{include_dirs}} {{cflags}} {{cflags_c}}${extra_cppflags}${extra_cflags}${module_name_flag} -c {{source}} -o $output"
      depsformat = "gcc"
      description = "CC {{output}}"
      outputs = [ output ]
    }

    tool("cxx") {
      output = "$object_subdir/{{source_name_part}}.o"
      depfile = "$output.d"
      precompiled_header_type = "gcc"

      command = "$cxx $md -MF $depfile {{defines}} {{include_dirs}} {{cflags}} {{cflags_cc}}${extra_cppflags}${extra_cxxflags} {{module_deps}}${module_name_flag} -c {{source}} -o $output"
      depsformat = "gcc"
      description = "CXX {{output}}"
      outputs = [ output ]
    }

    tool("asm") {
      depfile = "{{output}}.d"
      command = "$asm $md -MF $depfile {{defines}} {{include_dirs}} {{asmflags}}${extra_asmflags} -c {{source}} -o {{output}}"
      depsformat = "gcc"
      description = "ASM {{output}}"
      outputs = [ "$object_subdir/{{source_name_part}}.o" ]
    }

    tool("alink") {
      if (current_os == "aix") {
        command = "$ar -X64 {{arflags}} -r -c {{output}} {{inputs}}"
      } else {
        rspfile = "{{output}}.rsp"
        rspfile_content = "{{inputs}}"
        command = "\"$ar\" {{arflags}} -r -c -D {{output}} @\"$rspfile\""
      }

      command = "rm -f {{output}} && $command"

      if (ar != "" && get_path_info(ar, "file") != ar) {
        inputs =
            [ get_path_info(rebase_path(ar, ".", root_build_dir), "abspath") ]
      }

      description = "AR {{output}}"
      outputs = [ "{{output_dir}}/{{target_output_name}}{{output_extension}}" ]

      default_output_dir = "{{target_out_dir}}"
      default_output_extension = ".a"
      output_prefix = "lib"
    }

    tool("solink") {
      soname = "{{target_output_name}}{{output_extension}}"  # e.g. "libfoo.so".
      sofile = "{{output_dir}}/$soname"  # Possibly including toolchain dir.
      rspfile = sofile + ".rsp"

      if (defined(invoker.strip)) {
        sofile_with_symbols = "{{root_out_dir}}/lib.unstripped/$soname"
      } else {
        sofile_with_symbols = sofile
      }
      tocfile = sofile + ".TOC"

      if (current_os == "mac") {
        soname_flag = "-Wl,-install_name,@rpath/$soname"
      } else if (current_os != "aix") {
        soname_flag = "-Wl,-soname=\"$soname\""
      } else {
        soname_flag = ""
      }

      main_so_file = sofile_with_symbols
      link_command = "$ld -shared $soname_flag {{ldflags}}${extra_ldflags} -o \"$main_so_file\" @\"$rspfile\" {{rlibs}}"

      # assert(defined(readelf), "to solink you must have a readelf")
      # assert(defined(nm), "to solink you must have an nm")

      toc_command = "($readelf -g \"$main_so_file\" || $nm -gD \"$main_so_file\") > \"$tocfile\" 2>/dev/null"

      solink_extra_flags = ""
      if (current_os == "aix") {
        solink_extra_flags = "--partitioned-library"
      }

      if (defined(invoker.strip)) {
        strip_command =
            "${invoker.strip} -o \"$sofile\" \"$sofile_with_symbols\""
        command = "$link_command $solink_extra_flags && $strip_command && $toc_command"
      } else {
        command = "$link_command $solink_extra_flags && $toc_command"
      }

      if (current_os == "mac" || current_os == "win" || current_os == "aix") {
        rspfile_content = "{{inputs}} {{solibs}} {{libs}}"
      } else if (target_cpu == "mipsel" && is_component_build && is_android) {
        rspfile_content = "-Wl,--start-group -Wl,--whole-archive {{inputs}} {{solibs}} -Wl,--no-whole-archive {{libs}} -Wl,--end-group"
      } else {
        rspfile_content = "-Wl,--whole-archive {{inputs}} {{solibs}} -Wl,--no-whole-archive {{libs}}"
      }

      description = "SOLINK $sofile"
      default_output_extension = default_shlib_extension
      default_output_dir = "{{root_out_dir}}${default_shlib_subdir}"
      output_prefix = "lib"
      restat = true

      outputs = [
        sofile,
        tocfile,
      ]
      if (sofile != sofile_with_symbols) {
        outputs += [ sofile_with_symbols ]
        if (defined(invoker.use_unstripped_as_runtime_outputs) &&
            invoker.use_unstripped_as_runtime_outputs) {
          runtime_outputs = [ sofile_with_symbols ]
        }
      }

      if (defined(map_file)) {
        outputs += [ map_file ]
      }
      link_output = sofile
      depend_output = tocfile
    }

    tool("solink_module") {
      soname = "{{target_output_name}}{{output_extension}}"  # e.g. "libfoo.so".
      sofile = "{{output_dir}}/$soname"
      rspfile = sofile + ".rsp"

      if (defined(invoker.strip)) {
        sofile_with_symbols = "{{root_out_dir}}/lib.unstripped/$soname"
      } else {
        sofile_with_symbols = sofile
      }

      if (current_os == "mac") {
        soname_flag = "-Wl,-install_name,@rpath/$soname"
      } else if (current_os != "aix" && current_os != "win") {
        soname_flag = "-Wl,-soname=\"$soname\""
      } else {
        soname_flag = ""
      }

      main_so_file = sofile_with_symbols
      command = "$ld -shared $soname_flag {{ldflags}}${extra_ldflags} -o \"$main_so_file\" @\"$rspfile\" {{rlibs}}"

      if (defined(invoker.strip)) {
        strip_command =
            "${invoker.strip} -o \"$sofile\" \"$sofile_with_symbols\""
        command += " && " + strip_command
      }

      if (current_os == "mac" || current_os == "win") {
        rspfile_content = "{{inputs}} {{solibs}} {{libs}} {{rlibs}}"
      } else {
        whole_archive_flag = "-Wl,--whole-archive"
        no_whole_archive_flag = "-Wl,--no-whole-archive"
        rspfile_content = "$whole_archive_flag {{inputs}} {{solibs}} $no_whole_archive_flag {{libs}} {{rlibs}}"
      }

      description = "SOLINK_MODULE $sofile"

      if (defined(invoker.loadable_module_extension)) {
        default_output_extension = invoker.loadable_module_extension
      } else {
        default_output_extension = default_shlib_extension
      }
      default_output_dir = "{{root_out_dir}}${default_shlib_subdir}"
      output_prefix = "lib"

      outputs = [ sofile ]
      if (sofile != sofile_with_symbols) {
        outputs += [ sofile_with_symbols ]
        if (defined(invoker.use_unstripped_as_runtime_outputs) &&
            invoker.use_unstripped_as_runtime_outputs) {
          runtime_outputs = [ sofile_with_symbols ]
        }
      }
    }

    tool("link") {
      exename = "{{target_output_name}}{{output_extension}}"
      outfile = "{{output_dir}}/$exename"
      rspfile = "$outfile.rsp"

      default_output_extension = default_executable_extension
      default_output_dir = "{{root_out_dir}}"

      # The unstripped split requires chaining link and strip with "&&",
      # which the Windows shell invocation does not interpret, and which
      # llvm-strip cannot handle for Emscripten outputs. Link directly on
      # those platforms; neither carries debug info in release anyway.
      use_strip = defined(invoker.strip) && current_os != "win" &&
                  current_os != "emscripten"
      if (use_strip) {
        outfile_with_symbols = "{{root_out_dir}}/exe.unstripped/$exename"
      } else {
        outfile_with_symbols = outfile
      }

      main_outfile = outfile_with_symbols
      link_command = "$ld {{ldflags}}${extra_ldflags} -o \"$main_outfile\" "

      if (current_os == "mac" || current_os == "win" ||
          current_os == "emscripten") {
        link_command += "@\"$rspfile\" {{solibs}} {{libs}} {{rlibs}}"
      } else {
        start_group_flag = "-Wl,--start-group"
        end_group_flag = "-Wl,--end-group "
        link_command += "$start_group_flag @\"$rspfile\" $end_group_flag {{solibs}} {{libs}} $start_group_flag {{rlibs}} $end_group_flag"
      }

      if (use_strip) {
        strip_command = "${invoker.strip} -o \"$outfile\" \"$main_outfile\""
        command = "$link_command && $strip_command"
      } else {
        command = link_command
      }

      description = "LINK $outfile"

      rspfile_content = "{{inputs}}"
      outputs = [ outfile ]
      if (outfile != outfile_with_symbols) {
        outputs += [ outfile_with_symbols ]
        if (defined(invoker.use_unstripped_as_runtime_outputs) &&
            invoker.use_unstripped_as_runtime_outputs) {
          runtime_outputs = [ outfile_with_symbols ]
        }
      }

      if (defined(invoker.link_outputs)) {
        outputs += invoker.link_outputs
      }
      if (defined(map_file)) {
        outputs += [ map_file ]
      }
    }
  }
}

template("gcc_toolchain") {
  gcc_clang(target_name) {
    cc = "gcc"
    cxx = "g++"
    ld = cxx
    ar = "ar"

    readelf_bin = "readelf"
    if (defined(invoker.readelf)) {
      readelf_bin = invoker.readelf
    }
    nm_bin = "nm"
    if (defined(invoker.nm)) {
      nm_bin = "nm"
    }
    objcopy_bin = "objcopy"
    if (defined(invoker.objcopy)) {
      objcopy_bin = invoker.objcopy
    }
    strip_bin = "strip"
    if (defined(invoker.strip)) {
      strip_bin = invoker.strip
    }

    readelf = readelf_bin
    nm = nm_bin
    objcopy = objcopy_bin

    if (!is_debug) {
      strip = strip_bin
    }

    forward_variables_from(invoker,
                           "*",
                           [
                             "toolchain_args",
                             "readelf",
                             "nm",
                             "objcopy",
                             "strip",
                           ])

    toolchain_args = {
      is_clang = false
      readelf = readelf_bin
      nm = nm_bin
      objcopy = objcopy_bin
      strip = strip_bin
      if (defined(invoker.toolchain_args)) {
        forward_variables_from(invoker.toolchain_args, "*")
      }
    }
  }
}

template("clang_toolchain") {
  gcc_clang(target_name) {
    cc = "clang"
    cxx = "clang++"
    ld = cxx
    ar = "llvm-ar"

    readelf_bin = "llvm-readelf"
    if (defined(invoker.readelf)) {
      readelf_bin = invoker.readelf
    }
    nm_bin = "llvm-nm"
    if (defined(invoker.nm)) {
      nm_bin = "llvm-nm"
    }
    objcopy_bin = "llvm-objcopy"
    if (defined(invoker.objcopy)) {
      objcopy_bin = invoker.objcopy
    }
    strip_bin = "llvm-strip"
    if (defined(invoker.strip)) {
      strip_bin = invoker.strip
    }

    readelf = readelf_bin
    nm = nm_bin
    objcopy = objcopy_bin

    if (!is_debug) {
      strip = strip_bin
    }

    forward_variables_from(invoker,
                           "*",
                           [
                             "toolchain_args",
                             "readelf",
                             "nm",
                             "objcopy",
                             "strip",
                           ])

    toolchain_args = {
      is_clang = true
      readelf = readelf_bin
      nm = nm_bin
      objcopy = objcopy_bin
      strip = strip_bin
      if (defined(invoker.toolchain_args)) {
        forward_variables_from(invoker.toolchain_args, "*")
      }
    }
  }
}
