{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "alcy",
      "camelcase": "Alcy",
      "title": "alcy",
      "scope": "source.alcy",
      "path": ".",
      "file-types": [
        "al"
      ],
      "highlights": "queries/alcy/highlights.scm",
      "tags": "queries/alcy/tags.scm",
      "injection-regex": "^alcy$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "Apache-2.0 WITH LLVM-exception",
    "description": "alcy grammar for tree-sitter",
    "authors": [
      {
        "name": "The Alcy Project Authors"
      }
    ],
    "links": {
      "repository": "https://github.com/pug523/alcy"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "kotlin": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
