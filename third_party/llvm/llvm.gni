declare_args() {
  cache_llvm = true

  # A preinstalled LLVM prefix to use instead of the fork's tag artifact.
  # The directory needs include/ and lib/ like an install; setup_llvm is
  # skipped when it is set, so nothing is downloaded.
  llvm_install_dir = ""
}

declare_args() {
  # Link the lld the install carries into the compiler, so a program
  # links in-process by default. Native Linux targets only for now: the
  # embedded linker is a linker and not a driver, so the compiler has to
  # find the host's startup inputs itself, and that discovery exists for
  # Linux; another target CPU would need an install built for it, which
  # the tag download does not stage. Other targets keep spawning their
  # driver until their own discovery lands. A `linker` in
  # .alcy/toolchain.toml or `--linker` on the command line replaces the
  # default either way.
  alcy_embedded_lld = is_linux && target_cpu == host_cpu
}

if (is_debug) {
  llvm_build_type = "Debug"
  build_type_lower = "debug"
} else {
  # llvm_build_type = "RelWithDebInfo"
  llvm_build_type = "Release"
  build_type_lower = "release"
}

llvm_root_out_dir = "$root_build_dir/third_party/llvm"
download_dir = "$llvm_root_out_dir/download/$build_type_lower"
if (llvm_install_dir != "") {
  install_dir = llvm_install_dir
} else {
  install_dir = "$llvm_root_out_dir/install/$build_type_lower"
}

# setup_llvm.py detects the host triple at runtime; only override it when
# cross-compiling (wasm builds run on a native host but link wasm LLVM).
llvm_triple_args = []
if (is_wasm) {
  llvm_triple_args = [ "--triple=wasm32-unknown-emscripten" ]
}

