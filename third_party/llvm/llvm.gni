declare_args() {
  cache_llvm = true
}

if (is_debug) {
  llvm_build_type = "Debug"
  build_type_lower = "debug"
} else {
  # llvm_build_type = "RelWithDebInfo"
  llvm_build_type = "Release"
  build_type_lower = "release"
}

llvm_root_out_dir = "$root_build_dir/third_party/llvm"
install_dir = "$llvm_root_out_dir/install/$build_type_lower"
download_dir = "$llvm_root_out_dir/download/$build_type_lower"

# setup_llvm.py detects the host triple at runtime; only override it when
# cross-compiling (wasm builds run on a native host but link wasm LLVM).
llvm_triple_args = []
if (is_wasm) {
  llvm_triple_args = [ "--triple=wasm32-unknown-emscripten" ]
}

# Host codegen backends for object emission. Only the matching
# backend links in; object emission on other triples reports an
# error instead of linking every backend everywhere. Backend
# archives precede the libraries they depend on (static link order).
llvm_backend_components = []
if (!is_wasm) {
  if (target_cpu == "x64" || target_cpu == "x86") {
    llvm_backend_components += [
      "LLVMX86CodeGen",
      "LLVMX86Desc",
      "LLVMX86Info",
    ]
  } else if (target_cpu == "arm64") {
    llvm_backend_components += [
      "LLVMAArch64CodeGen",
      "LLVMAArch64Desc",
      "LLVMAArch64Info",
    ]
  }
  if (llvm_backend_components != []) {
    llvm_backend_components += [
      "LLVMAsmPrinter",
      "LLVMSelectionDAG",
      "LLVMGlobalISel",
      "LLVMInstrumentation",
      "LLVMCFGuard",
      "LLVMMCDisassembler",
      "LLVMIRPrinter",
    ]
  }
}

llvm_components = llvm_backend_components + [
  "LLVMCodeGen",
  "LLVMTarget",
  "LLVMScalarOpts",
  "LLVMInstCombine",
  "LLVMAggressiveInstCombine",
  "LLVMObjCARCOpts",
  "LLVMTransformUtils",
  "LLVMCodeGenTypes",
  "LLVMCGData",
  "LLVMBitWriter",
  "LLVMAnalysis",
  "LLVMProfileData",
  "LLVMSymbolize",
  "LLVMDebugInfoBTF",
  "LLVMDebugInfoPDB",
  "LLVMDebugInfoMSF",
  "LLVMDebugInfoCodeView",
  "LLVMDebugInfoGSYM",
  "LLVMDebugInfoDWARF",
  "LLVMObject",
  "LLVMTextAPI",
  "LLVMMCParser",
  "LLVMIRReader",
  "LLVMAsmParser",
  "LLVMMC",
  "LLVMDebugInfoDWARFLowLevel",
  "LLVMBitReader",
  "LLVMFrontendHLSL",
  "LLVMCore",
  "LLVMRemarks",
  "LLVMBitstreamReader",
  "LLVMBinaryFormat",
  "LLVMTargetParser",
  "LLVMSupport",
  "LLVMDemangle",
]
