{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmitOnError": true,
    "sourceMap": true,
    "inlineSources": true,
    "rootDir": ".",
    "outDir": "build",
    "newLine": "lf"
  },
  "include": ["*.ts"],
  "exclude": ["build", "compiler.worker.ts", "runner.worker.ts", "wasm-api.ts", "wasi.ts"]
}
