declare_args() {
  # The optional backend implementations compiled into the compiler.
  # "llvm" brings the prebuilt LLVM, and on native Linux the embedded ELF
  # linker with it. The direct backends need neither and are always
  # built, so this list is about what to add, not what to leave out. A
  # build with no backend still checks.
  alcy_backends = [ "llvm" ]
}

alcy_use_llvm = filter_include(alcy_backends, [ "llvm" ]) != []
