source_set("diag") {
  sources = [
    "bag.cc",
    "bag.h",
    "diagnostic.h",
    "render.cc",
    "render.h",
    "span.h",
  ]

  # Depends on source only for the FileId identity minted there; the
  # direction is one-way (source never includes diag headers).
  deps = [
    "//src:base_modules",
    "//src/source",
  ]
  configs += [ "//src:alcy_config" ]
}
