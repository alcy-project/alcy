source_set("driver") {
  sources = [
    "converters.h",
    "driver_config.cc",
    "driver_config.h",
    "driver_main.cc",
    "driver_main.h",
    "init_handler.cc",
    "init_handler.h",
    "parse_args.cc",
    "parse_args.h",
    "result_code.h",
  ]
  defines = [
    "ALCY_PROJECT_NAME=\"$project_name\"",
    "ALCY_PROJECT_VERSION=\"$project_version\"",
    "ALCY_COMMAND_ABOUT=\"$command_about\"",
  ]

  configs += [
    "//src:alcy_config",
    "//src:win_sys_libs",
  ]

  # Public: driver headers include compiler and third-party headers, so
  # dependents need the same include paths (private deps would not forward
  # them, breaking both compilation and gn check of dependents).
  public_deps = [ "//src:alcy_lib" ]
}

executable("alcy") {
  sources = [ "main.cc" ]

  configs += [
    "//src:alcy_config",
    "//src:win_sys_libs",
  ]
  deps = [ ":driver" ]
}
