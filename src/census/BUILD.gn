# The compile-time evaluator's census driver. A development tool rather
# than a user command: tools/check_comp.py compiles the acceptance
# corpus into the binary IR form and hands the packages here.
executable("comp_census") {
  sources = [ "main.cc" ]

  configs += [
    "//src:alcy_config",
    "//src:win_stack_reserve",
    "//src:win_sys_libs",
  ]

  deps = [ "//src:alcy_lib" ]
}
