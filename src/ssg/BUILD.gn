# The site generator's library: parses the Markdown subset the guide
# and the reference are written in, renders the page trees, and stamps
# the catalog from the site's shared catalog.json. The core has no
# compiler dependencies; the tool that wires it to the fence compiler
# lives in src/docsite/.
source_set("ssg") {
  sources = [
    "catalog.cc",
    "catalog.h",
    "discover.cc",
    "discover.h",
    "documents.cc",
    "documents.h",
    "highlight.cc",
    "highlight.h",
    "links.cc",
    "links.h",
    "markdown.cc",
    "markdown.h",
    "paths.cc",
    "paths.h",
    "render.cc",
    "render.h",
    "shell.cc",
    "shell.h",
    "template.cc",
    "template.h",
    "urls.cc",
    "urls.h",
  ]

  configs += [ "//src:alcy_config" ]
  public_configs = [ "//src:alcy_config" ]

  deps = [
    "//src:base_modules",
    "//third_party/fpag",
    "//third_party/tree-sitter",
    "//treesitter:grammar",
  ]
}
