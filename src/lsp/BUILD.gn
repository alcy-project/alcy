# The language server: a library over the frontend and the toolchain
# modules, invoked as `alcy lsp`. Like the linter it is a module of the
# toolchain tree rather than a stage of the compiler, so no compiler
# target depends on it and the cli links it instead.
source_set("lsp") {
  sources = [
    "analysis.cc",
    "analysis.h",
    "analysis_cache.cc",
    "analysis_cache.h",
    "ast_query.cc",
    "ast_query.h",
    "completion.cc",
    "completion.h",
    "diagnostics.cc",
    "diagnostics.h",
    "document.cc",
    "document.h",
    "folding.cc",
    "folding.h",
    "formatting.cc",
    "formatting.h",
    "frame.cc",
    "frame.h",
    "hover.cc",
    "hover.h",
    "inlay_hints.cc",
    "inlay_hints.h",
    "layout.cc",
    "layout.h",
    "lsp.cc",
    "lsp.h",
    "navigation.cc",
    "navigation.h",
    "protocol.cc",
    "protocol.h",
    "server.cc",
    "server.h",
    "signature.cc",
    "signature.h",
    "symbols.cc",
    "symbols.h",
    "transport.cc",
    "transport.h",
    "typing.cc",
    "typing.h",
  ]

  deps = [
    "//src:alcy_lib",
    "//src/cst",
    "//src/fmt:alcy_fmt",
    "//src/linter",
  ]

  configs += [
    "//src:alcy_config",
    "//src:win_sys_libs",
  ]

  public_configs = [ "//src:alcy_config" ]
}
