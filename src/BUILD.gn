group("alcy") {
  deps = [
    ":libs",
    "app:alcy",
  ]
}

config("alcy_config") {
  include_dirs = [ "//src" ]
}

group("base_modules") {
  public_deps = [
    "base",
    "build",
    "debug",
    "//third_party/fpag",
  ]
}

group("modules") {
  public_deps = [
    ":base_modules",
    "analyzer",
    "ast",
    "codegen",
    "codegen_llvm",
    "core",
    "ir",
    "lexer",
    "parser",
    "pipeline",
  ]
}

group("libs") {
  public_deps = [
    ":base_modules",
    ":modules",
  ]
}

config("win_sys_libs") {
  if (is_win) {
    libs = [
      "dbghelp",
      "onecore",
      "ntdll",
    ]
  }
}
