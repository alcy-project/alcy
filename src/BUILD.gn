group("alcy") {
  deps = [
    ":libs",
    "cli:alcy",
  ]
}

config("alcy_config") {
  include_dirs = [ "//src" ]
}

group("base_modules") {
  public_deps = [
    "base",
    "config",
    "debug",
    "//third_party/fpag",
  ]
}

group("modules") {
  public_deps = [
    ":base_modules",
    "analyzer",
    "ast",
    "borrow",
    "codegen",
    "codegen_llvm",
    "diag",
    "ir",
    "lexer",
    "lower",
    "parser",
    "path",
    "pkg",
    "source",
    "symbol",
  ]
}

group("libs") {
  public_deps = [
    ":base_modules",
    ":modules",
    "pipeline",
  ]
}

# Single static library archiving every compiler module. Executables link
# only against this target, so CI and releases can ship the archive itself
# (native libalcy.a / alcy.lib, wasm libalcy.a for the playground).
static_library("alcy_lib") {
  output_name = "alcy"
  output_dir = root_out_dir
  complete_static_lib = true
  public_deps = [ ":libs" ]
}

config("win_sys_libs") {
  if (is_win) {
    libs = [
      "dbghelp",
      "onecore",
      "ntdll",
    ]
  }
}
