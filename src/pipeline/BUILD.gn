import("//src/backends.gni")

action("embed_std") {
  script = "//tools/embed_std.py"
  inputs = [
    "//lib/std/alcy.toml",
    "//lib/std/core/alcy.toml",
    "//lib/std/alloc/alcy.toml",
    "//lib/std/collections/alcy.toml",
    "//lib/std/fmt/alcy.toml",
    "//lib/std/atomic/alcy.toml",
    "//lib/std/sync/alcy.toml",
    "//lib/std/io/alcy.toml",
    "//lib/std/network/alcy.toml",
    "//lib/std/thread/alcy.toml",
    "//lib/std/arch/alcy.toml",
    "//lib/std/simd/alcy.toml",
    "//lib/std/time/alcy.toml",
    "//lib/std/text/alcy.toml",
    "//lib/std/unicode/alcy.toml",
    "//lib/std/core/prelude.al",
    "//lib/std/core/anchor.al",
    "//lib/std/core/cmp.al",
    "//lib/std/core/index.al",
    "//lib/std/core/iterator.al",
    "//lib/std/core/mem.al",
    "//lib/std/core/ops.al",
    "//lib/std/core/option.al",
    "//lib/std/core/range.al",
    "//lib/std/core/result.al",
    "//lib/std/core/slice.al",
    "//lib/std/core/string.al",
    "//lib/std/alloc/prelude.al",
    "//lib/std/alloc/heap.al",
    "//lib/std/alloc/box.al",
    "//lib/std/alloc/vec.al",
    "//lib/std/collections/prelude.al",
    "//lib/std/collections/map.al",
    "//lib/std/collections/set.al",
    "//lib/std/fmt/prelude.al",
    "//lib/std/fmt/display.al",
    "//lib/std/fmt/write.al",
    "//lib/std/fmt/format.al",
    "//lib/std/atomic/prelude.al",
    "//lib/std/sync/prelude.al",
    "//lib/std/io/prelude.al",
    "//lib/std/io/print.al",
    "//lib/std/network/prelude.al",
    "//lib/std/thread/prelude.al",
    "//lib/std/arch/prelude.al",
    "//lib/std/simd/prelude.al",
    "//lib/std/time/prelude.al",
    "//lib/std/text/prelude.al",
    "//lib/std/text/string.al",
    "//lib/std/unicode/prelude.al",
    "//lib/std/unicode/utf8.al",
  ]
  outputs = [ "$target_gen_dir/embedded_std.cc" ]

  # The script writes what it read: a module's bytes change without the
  # list above changing, and stale bytes would be embedded silently.
  depfile = "$target_gen_dir/embedded_std.d"
  args = [
    "--std-dir",
    rebase_path("//lib/std", root_build_dir),
    "--output",
    rebase_path("$target_gen_dir/embedded_std.cc", root_build_dir),
    "--depfile",
    rebase_path("$target_gen_dir/embedded_std.d", root_build_dir),
  ]
}

source_set("pipeline") {
  sources = [
    "$target_gen_dir/embedded_std.cc",
    "backend_emit.cc",
    "backend_emit.h",
    "build.cc",
    "build.h",
    "build_plan.h",
    "cache.cc",
    "cache.h",
    "call_sites.cc",
    "call_sites.h",
    "check.cc",
    "check.h",
    "dependencies.cc",
    "dependencies.h",
    "diag_code.h",
    "embedded_lld.cc",
    "embedded_lld.h",
    "embedded_std.h",
    "emit_mode.cc",
    "emit_mode.h",
    "frontend.cc",
    "frontend.h",
    "link_options.h",
    "modules.cc",
    "modules.h",
    "new.cc",
    "new.h",
    "parse.cc",
    "parse.h",
    "pipeline.cc",
    "pipeline.h",
    "pipeline_context.cc",
    "pipeline_context.h",
    "profile.cc",
    "profile.h",
    "run.cc",
    "run.h",
    "spawn.cc",
    "spawn.h",
    "std_select.cc",
    "std_select.h",
    "std_stage.cc",
    "std_stage.h",
    "target.cc",
    "target.h",
    "vcs.cc",
    "vcs.h",
  ]

  # The modules this one includes, named rather than reached through
  # `//src:modules`: an include that no direct dependency covers is a
  # `gn check` failure, so the pipeline's reach is its declared edges.
  deps = [
    ":embed_std",
    "//src:base_modules",
    "//src/analyzer",
    "//src/ast",
    "//src/borrow",
    "//src/codegen",
    "//src/codegen/wasm",
    "//src/diag",
    "//src/i18n",
    "//src/ir",
    "//src/lexer",
    "//src/lowering",
    "//src/opt",
    "//src/overlay",
    "//src/parser",
    "//src/path",
    "//src/pkg",
    "//src/source",
    "//src/symbol",
  ]

  # The dispatch reaches the implementations; a build that carries none
  # has nothing to reach, and not depending on them is what keeps the
  # prebuilt LLVM out of it.
  if (alcy_use_llvm) {
    deps += [ "//src/codegen_llvm" ]
  }
  configs += [ "//src:alcy_config" ]
}
