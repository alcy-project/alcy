  F(CliJsonHelp, Note, Pipeline, "Report the result as one JSON document on standard output, for a tool reading it. Applies to build, compile, check, and lint.") \
  F(CliJobsHelp, Note, Pipeline, "How many threads read the source at once. Reading files is the only part of a run spread over them; everything after it is one thread. One by default, because a threaded read leaves the passes that read what it built to find nodes in an order that costs them more than the read saves.") \
  F(CliJsonOnlyForResultVerbs, Note, Pipeline, "`--json` only means anything for `build`, `compile`, `check`, and `lint`") \
  F(CliLangHelp, Note, Pipeline, "Language for every message this run prints. Taken from this flag alone: the locale the shell exports is not consulted, so the same command line reports the same text on every machine.") \
  F(CliLinkArgsOverrideHelp, Note, Pipeline, "Argument for the link driver, after the objects. Repeatable, one argument each; overrides .alcy/toolchain.toml.") \
  F(CliLinkerOverrideHelp, Note, Pipeline, "System linker driver for executable builds. Overrides .alcy/toolchain.toml.") \
  F(CliMemoryPeak, Note, Pipeline, "{} peak") \
  F(CliModulePlural, Note, Pipeline, "modules") \
  F(CliModuleSingular, Note, Pipeline, "module") \
  F(CliNewAbout, Note, Pipeline, "Create a new package") \
  F(CliNoStdHelp, Note, Pipeline, "Start with no standard library instead of the default suite. Add back with --deps.") \
  F(CliNoCacheHelp, Note, Pipeline, "Skip the build cache for this invocation: no lookup and no store.") \
  F(CliNoSubcommand, Note, Pipeline, "No subcommand given") \
  F(CliOnPanicHelp, Note, Pipeline, "What a panic does before it aborts: abort (the default) writes the message, and backtrace also names the frames it can walk. Overrides the selected profile's on-panic.") \
  F(CliOptimizeHelp, Note, Pipeline, "Whether the middle end and the release passes run: on or off. Overrides the selected profile's optimize.") \
  F(CliOverflowChecksHelp, Note, Pipeline, "Whether the source arithmetic aborts on overflow: on or off. Overrides the selected profile's overflow-checks.") \
