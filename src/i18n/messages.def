// The message catalog: every user-visible message the compiler can
// print, one entry each, grouped by the module that emits it. The
// diagnostic code stays at the call site, because it is a stable
// identifier for tooling and half of the registered codes carry more
// than one wording.
//
// The list is included with different adapters to build the key enum,
// the per-language tables, and the cli's choice lists, so the ordinals,
// the catalogs, and the flag values cannot drift apart. A name is
// spelled `ModuleWhatIsWrong` after the module that emits it, and
// changing a text never changes a name: a name is the identity a
// translation is keyed by.
//
// Format strings are fmt syntax. A translation may reorder the
// placeholders and reword around them, and may not add, drop, or
// retype one: every catalog is parsed against the call site's
// arguments at compile time.

#define ALCY_I18N_FOREACH_KEY_EN_US(F) \
  /* lexer */ \
  F(LexerEmptyCharacter, Error, Lexer, "Empty character literal") \
  F(LexerInvalidCharacter, Error, Lexer, "Invalid character") \
  F(LexerInvalidEscapeInCharacter, Error, Lexer, "Invalid escape in character literal") \
  F(LexerInvalidEscapeInString, Error, Lexer, "Invalid escape in string literal") \
  F(LexerInvalidNumber, Error, Lexer, "Invalid number literal") \
  F(LexerUnicodeEscapeNotScalar, Error, Lexer, "A \\u{{...}} escape must name a Unicode scalar value") \
  F(LexerUnterminatedBlockComment, Error, Lexer, "Unterminated block comment") \
  F(LexerUnterminatedCharacter, Error, Lexer, "Unterminated character literal") \
  F(LexerUnterminatedString, Error, Lexer, "Unterminated string literal") \
  /* parser */ \
  F(ArgCommand, Note, Pipeline, "Command") \
  F(ArgCommands, Note, Pipeline, "Commands") \
  F(ArgDefault, Note, Pipeline, "(default: {})") \
  F(ArgDuplicateOption, Note, Pipeline, "The argument '{}' was provided more than once") \
  F(ArgFlagTakesNoValue, Note, Pipeline, "Flag '{}' takes no value") \
  F(ArgHelpOption, Note, Pipeline, "Print help message") \
  F(ArgInvalidArgCount, Note, Pipeline, "Invalid arg count provided: {}") \
  F(ArgInvalidChoice, Note, Pipeline, "Invalid choice for argument '{}': '{}'") \
  F(ArgInvalidValue, Note, Pipeline, "Invalid value for argument '{}': '{}'") \
  F(ArgMissingRequiredArgument, Note, Pipeline, "The required argument '{}' was not provided") \
  F(ArgMissingValueForOption, Note, Pipeline, "A value is required for '{}' but none was supplied") \
  F(ArgNullMatchesPointer, Note, Pipeline, "Output matches pointer is null") \
  F(ArgOptions, Note, Pipeline, "Options") \
  F(ArgRequired, Note, Pipeline, "[required]") \
  F(ArgTryHelp, Note, Pipeline, "For more information, try '{} --help'.") \
  F(ArgUnknownLongOption, Note, Pipeline, "Unexpected argument '--{}' found") \
  F(ArgUnknownShortOption, Note, Pipeline, "Unexpected argument '-{}' found") \
  F(ArgUsage, Note, Pipeline, "Usage") \
  F(ArgValueName, Note, Pipeline, "value") \
  F(ArgVersionOption, Note, Pipeline, "Print version information") \
  F(ParserArrayLengthNotDecimal, Error, Parser, "Array length must be decimal") \
  F(ParserArrayLengthTooLarge, Error, Parser, "Array length is too large") \
  F(ParserArrayLiteralWithoutCount, Error, Parser, "Array literal needs elements or a repeat count") \
  F(ParserBlockBraceOnHeader, Error, Parser, "A block's `{{` must stay on its header line") \
  F(ParserCompDeclarationSpelling, Error, Parser, "`comp` marks parameters and blocks; write the declaration as `const x := ...`") \
  F(ParserCompOnlyOnBindings, Error, Parser, "Comp evaluation is only allowed on parameters and blocks") \
  F(ParserCompOnlyOnFunctions, Error, Parser, "`comp` marks a function in item position") \
  F(ParserCompUnsafeCombination, Error, Parser, "`comp` and `unsafe` do not combine yet") \
  F(ParserDuplicateTypeParameter, Error, Parser, "Duplicate type parameter '{}'") \
  F(ParserExpectedFound, Error, Parser, "Expected {}, found `{}`") \
  F(ParserExpectedFoundEndOfFile, Error, Parser, "Expected {}, found end of file") \
  F(ParserExpectedItemFound, Error, Parser, "Expected item, found `{}`") \
  F(ParserExpectedItemFoundEndOfFile, Error, Parser, "Expected item, found end of file") \
  F(ParserExpectedSemicolon, Error, Parser, "Expected `;`") \
  F(ParserFnItemSpelling, Error, Parser, "`fn` declares a function") \
  F(ParserIfLetSpelling, Error, Parser, "a condition binds with `:=`: write `if PAT := EXPR`") \
  F(ParserExternConvention, Error, Parser, "Only the \"C\" calling convention is supported") \
  F(ParserExternNeedsConvention, Error, Parser, "`extern` needs a convention string (`extern \"C\"`)") \
  F(ParserInvalidSyntaxTree, Error, Parser, "Internal error: invalid syntax tree: {}") \
  F(AnalyzerInvalidSyntaxTree, Error, Analyzer, "Internal error: invalid syntax tree: {}") \
  F(ParserInvalidTokenStream, Error, Parser, "Internal error: invalid token stream: {}") \
  F(ParserLetSpelling, Error, Parser, "`let` is not a keyword; declare with `x := ...` (`mut x := ...` when mutable)") \
  F(ParserMacroCallSpelling, Error, Parser, "alcy has no macros; call `name(...)`") \
  F(ParserModuleFromManifest, Error, Parser, "modules are declared in `alcy.toml`; there is no `mod`") \
  F(ParserMutDeclarationSpelling, Error, Parser, "a mutable declaration is `mut x := ...`; `=` only reassigns") \
  F(ParserNameAlreadyBound, Error, Parser, "Name `{}` is already bound in this scope") \
  F(ParserNestingTooDeep, Error, Parser, "Nesting is deeper than the limit of {}") \
  F(AnalyzerNestingTooDeep, Error, Analyzer, "Nesting is deeper than the limit of {}") \
  F(ParserRangeBoundRequired, Error, Parser, "`..<` and `..=` describe an endpoint, so one must follow") \
  F(ParserRangeEndNeedsBound, Error, Parser, "A range end must be spelled `..<` or `..=`, bare `..` names no end") \
  F(ParserRefSelfParameter, Error, Parser, "a receiver is `self: &Self` (`mut self: &mut Self` when exclusive)") \
  F(ParserReservedName, Error, Parser, "Name `{}` is reserved for future use") \
  F(ParserReturnSpelling, Error, Parser, "`ret` returns; write `ret ...`") \
  F(ParserSpecItemSpelling, Error, Parser, "`spec` declares a capability; `impl Spec for Type` opts a type in") \
  F(ParserTypeFirstDeclarationSpelling, Error, Parser, "a declaration puts the type after the name: `x: T := ...`") \
  F(ParserTypedDeclarationSpelling, Error, Parser, "a typed declaration is `x: T := ...`; `=` only reassigns") \
  F(ParserUnsafeOnlyOnFunctions, Error, Parser, "`unsafe` applies to functions") \
  F(ParserUnsafeWithoutBlock, Error, Parser, "`unsafe` must open a block (`unsafe {{ ... }}`)") \
  F(ParserUseItemSpelling, Error, Parser, "`use` imports a path") \
  F(ParserVariadicParameter, Error, Parser, "a variadic parameter is a plain name and the last one (`args: ..`)") \
  F(ParserVarSpelling, Error, Parser, "`var` is not a keyword; declare with `x := ...`") \
  /* analyzer */ \
  F(AnalyzerAmbiguousMethod, Error, Analyzer, "Ambiguous method '{}'") \
  F(AnalyzerAmbiguousVariant, Error, Analyzer, "Ambiguous variant '{}'") \
  F(AnalyzerArenaExhausted, Error, Analyzer, "The {} bytes of arena the compiler reserves for the syntax tree cannot hold this package") \
  F(AnalyzerArgumentsNotTuple, Error, Analyzer, "Arguments must be a tuple") \
