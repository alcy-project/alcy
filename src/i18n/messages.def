  F(CliLintDenyWarningsHelp, Note, Pipeline, "Fail on any finding: a warning is reported as an error.") \
  F(CliLintNoBorrowChecksHelp, Note, Pipeline, "Skip the lowering and borrow tail, the faster edit loop.") \
  F(CliLintFixSingular, Note, Pipeline, "fix") \
  F(CliLintFixPlural, Note, Pipeline, "fixes") \
  F(CliLintFindingPlural, Note, Pipeline, "findings") \
  F(CliLintFindingSingular, Note, Pipeline, "finding") \
  F(CliVerbLinted, Note, Pipeline, "Linted") \
  F(LintConfigIgnoreNotStrings, Error, Lint, "the ignore option of lint rule '{}' in {} must be an array of strings") \
  F(LintConfigLevelNotString, Error, Lint, "the level of lint rule '{}' in {} must be a string") \
  F(LintConfigBorrowChecksNotBool, Error, Lint, "the borrow-checks key in {} must be a boolean") \
  F(LintConfigDenyWarningsNotBool, Error, Lint, "the deny-warnings key in {} must be a boolean") \
  F(LintConfigOptionNotInteger, Error, Lint, "the max-args option of lint rule '{}' in {} must be an integer") \
  F(LintConfigRuleNotTable, Error, Lint, "lint rule '{}' in {} must be a level string or a table") \
  F(LintConfigSyntaxError, Error, Lint, "cannot parse {}: {}") \
  F(LintConfigUnknownLevel, Error, Lint, "unknown lint level '{}' in {}") \
  F(LintConfigUnknownRule, Error, Lint, "unknown lint rule '{}' in {}") \
  F(LintCliUnknownRule, Error, Lint, "unknown lint rule '{}' on the command line") \
  F(LintFixWriteFailed, Error, Lint, "cannot write the repair to {}") \
  F(LintBoolComparison, Warning, Lint, "this comparison can be simplified") \
  F(LintUnusedField, Warning, Lint, "field {} of {} is never read") \
  F(LintNeedlessBool, Warning, Lint, "this if can return its condition instead") \
  F(LintUnreachablePattern, Warning, Lint, "this pattern is unreachable; an earlier arm matches anything") \
  F(LintUnreachablePatternNote, Note, Lint, "the arm that matches anything is here") \
  F(LintUnusedVariant, Warning, Lint, "variant {} of {} is never constructed") \
  F(LintDeadCode, Warning, Lint, "function {} is never called") \
  F(LintDeadCodeNote, Note, Lint, "if this is meant as a public surface, declare it pub") \
  F(LintDoubleNegation, Warning, Lint, "double negation is a no-op") \
  F(LintEmptyLoop, Warning, Lint, "this loop has an empty body") \
  F(LintFloatEquality, Warning, Lint, "comparing floating-point values for equality is exact; use an ordering or an epsilon") \
  F(LintNeedlessBorrow, Warning, Lint, "this borrow of a dereference is the reference itself") \
  F(LintLossyCast, Warning, Lint, "this cast narrows {} to {}; the value may not fit") \
  F(LintUselessCast, Warning, Lint, "this cast does not change the value's type") \
  F(LintMissingDocs, Warning, Lint, "public item {} is missing a documentation comment") \
  F(LintNestedIf, Warning, Lint, "nested if can be collapsed into a single condition") \
  F(LintSelfComparison, Warning, Lint, "comparison of a value with itself") \
  F(LintShadow, Warning, Lint, "binding shadows an earlier binding: {}") \
  F(LintTooManyArguments, Warning, Lint, "function {} takes {} parameters, more than the {} allowed") \
  F(LintUnreachableCode, Warning, Lint, "unreachable statement") \
  F(LintUnusedMut, Warning, Lint, "variable does not need to be mutable: {}") \
  F(LintUnusedParameter, Warning, Lint, "unused parameter: {}") \
  F(LintUnusedImport, Warning, Lint, "unused import: {}") \
  F(LintUnusedVariable, Warning, Lint, "unused variable: {}") \
  F(LintUnusedVariableHelp, Warning, Lint, "if this is intentional, prefix the name with an underscore") \
  F(LintWhileTrue, Warning, Lint, "while true is a loop that never ends") \
  F(LintWhileTrueHelp, Warning, Lint, "use a loop expression instead") \
  /* diagnostic renderer */ \
  F(RenderDiagnosticsDroppedPlural, Note, Pipeline, "{} diagnostics were dropped: the compiler ran out of memory for them") \
  F(RenderDiagnosticsDroppedSingular, Note, Pipeline, "{} diagnostic was dropped: the compiler ran out of memory for it") \
  F(RenderSeverityError, Note, Pipeline, "error") \
  F(RenderSeverityNote, Note, Pipeline, "note") \
  F(RenderSeverityWarning, Note, Pipeline, "warning") \
  F(RenderUnknownFile, Note, Pipeline, "[unknown file]")
