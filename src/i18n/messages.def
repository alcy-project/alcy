  F(CliAbout, Note, Pipeline, "alcy language compiler") \
  F(CliBackendHelp, Note, Pipeline, "Which code generation backend writes the machine code: llvm (the default where it was built in), or direct-wasm for alcy's own wasm emitter.") \
