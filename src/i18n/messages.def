  F(AnalyzerArrayArity, Error, Analyzer, "Array expects {} elements, found {}") \
  F(AnalyzerArrayIndexNotInteger, Error, Analyzer, "Array index must be an integer") \
  F(AnalyzerArrayLengthNotConst, Error, Analyzer, "Array length must be a constant integer value") \
  F(AnalyzerArrayLiteralWithoutCount, Error, Analyzer, "Array literal needs elements or a repeat count") \
