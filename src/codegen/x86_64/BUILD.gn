# The direct x86_64 backend. Built into every compiler the direct wasm
# backend is, because a backend a debug build can be pointed at is the
# point of it.
source_set("x86_64") {
  sources = [
    "allocator.cc",
    "allocator.h",
    "backend.cc",
    "backend.h",
    "encoder.cc",
    "encoder.h",
    "frame.cc",
    "frame.h",
    "isa.cc",
    "isa.h",
    "minst.cc",
    "minst.h",
    "printer.cc",
    "printer.h",
    "rodata.h",
    "runtime.cc",
    "runtime.h",
    "selector.cc",
    "selector.h",
  ]
  deps = [
    "//src:base_modules",
    "//src/codegen",
    "//src/codegen/object",
    "//src/diag",
    "//src/i18n",
    "//src/ir",
    "//src/overlay",
    "//src/symbol",
  ]
  configs += [ "//src:alcy_config" ]
}
