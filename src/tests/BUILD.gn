executable("tests") {
  sources = [
    "analyzer/resolve_modules_test.cc",
    "analyzer/types_test.cc",
    "app/driver_main_test.cc",
    "app/new_command_test.cc",
    "app/parse_args_test.cc",
    "app/parse_output_test.cc",
    "ast/ast_test.cc",
    "borrow/borrow_test.cc",
    "codegen_llvm/llvm_ir_emitter_test.cc",
    "diag/bag_test.cc",
    "diag/render_test.cc",
    "ir/ir_common_test.cc",
    "ir/verifier_test.cc",
    "lexer/lexer_test.cc",
    "lexer/token_test.cc",
    "lower/lower_test.cc",
    "parser/desugar_test.cc",
    "parser/parser_test.cc",
    "path/path_test.cc",
    "pipeline/pipeline_test.cc",
    "pkg/lock_test.cc",
    "pkg/manifest_test.cc",
    "pkg/resolve_test.cc",
    "source/source_test.cc",
    "test_main.cc",
    "util/test_util.cc",
    "util/test_util.h",
  ]

  configs += [
    "//src:alcy_config",
    "//src:win_sys_libs",
  ]

  # doctest forward-declares std::ostream by default, which MSVC's
  # string_view operator<< cannot instantiate; including the real headers
  # fixes Windows builds (see doctest configuration.md). Must be global:
  # every TU including doctest needs it before the first include.
  defines = [ "DOCTEST_CONFIG_USE_STD_HEADERS" ]

  deps = [
    "//src:alcy_lib",
    "//src/app:driver",
    "//third_party/doctest",
  ]
}
