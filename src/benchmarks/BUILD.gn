# The engine, without the driver, so the unit tests can drive it with a
# fake clock: a duration that depends on the host is not a test.
source_set("bench") {
  sources = [
    "clock.cc",
    "clock.h",
    "generator.cc",
    "generator.h",
    "runner.cc",
    "runner.h",
    "sink.cc",
    "sink.h",
    "statistics.cc",
    "statistics.h",
  ]

  deps = [
    "//src:base_modules",
    "//src/text",
    "//third_party/fmt",
  ]

  configs += [ "//src:alcy_config" ]
}

# The microbenchmark driver. Separate from alcy so that nothing here is
# linked into the compiler: what a benchmark harness may do to the
# compiler is not something the compiler should carry.
executable("benchmarks") {
  sources = [
    "benchmark_main.cc",
    "case_frontend.cc",
    "case_frontend.h",
  ]

  configs += [
    "//src:alcy_config",
    "//src:win_sys_libs",
  ]

  deps = [
    ":bench",
    "//src:alcy_lib",
  ]
}
