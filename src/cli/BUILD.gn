# The version string is commit-dependent, so it lives alone in one
# generated translation unit. Regenerating it on a new commit recompiles
# this file and relinks; every other cli file keeps its command line. GN
# writes the file only when the string actually changes, so an unchanged
# version leaves the timestamp alone and nothing rebuilds.
write_file(
    "$target_gen_dir/version.cc",
    [
      "// Copyright 2026 The Alcy Project Authors",
      "// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception",
      "// Generated at gen time from the build's git state; do not edit.",
      "",
      "#include \"cli/version.h\"",
      "",
      "namespace cli {",
      "",
      "std::string_view alcy_version() { return \"" + alcy_version + "\"; }",
      "",
      "}  // namespace cli",
    ])

source_set("cli") {
  sources = [
    "$target_gen_dir/version.cc",
    "build_command.cc",
    "build_command.h",
    "check_command.cc",
    "check_command.h",
    "cli_config.cc",
    "cli_config.h",
    "cli_main.cc",
    "cli_main.h",
    "compile_command.cc",
    "compile_command.h",
    "converters.cc",
    "converters.h",
    "duration.cc",
    "duration.h",
    "fmt_command.cc",
    "fmt_command.h",
    "init_command.cc",
    "init_command.h",
    "init_handler.cc",
    "init_handler.h",
    "lint_command.cc",
    "lint_command.h",
    "logger.cc",
    "logger.h",
    "lsp_command.cc",
    "lsp_command.h",
    "new_command.cc",
    "new_command.h",
    "output.cc",
    "output.h",
    "parse_args.cc",
    "parse_args.h",
    "parse_output.cc",
    "parse_output.h",
    "result_code.cc",
    "result_code.h",
    "run_command.cc",
    "run_command.h",
    "suggest.cc",
    "suggest.h",
    "trace.cc",
    "trace.h",
    "trace_report.cc",
    "trace_report.h",
    "usage.cc",
    "usage.h",
    "validate.cc",
    "validate.h",
    "version.h",
  ]
  deps = [
    "//src/fmt:alcy_fmt",
    "//src/i18n",
    "//src/linter",
    "//src/lsp",
    "//src/pipeline",
  ]
  defines = [ "ALCY_PROJECT_NAME=\"$project_name\"" ]

  configs += [
    "//src:alcy_config",
    "//src:win_sys_libs",
  ]

  # Public: cli headers include compiler and third-party headers, so
  # dependents need the same include paths (private deps would not forward
  # them, breaking both compilation and gn check of dependents).
  public_deps = [ "//src:alcy_lib" ]
}

executable("alcy") {
  sources = [ "main.cc" ]

  configs += [
    "//src:alcy_config",
    "//src:win_stack_reserve",
    "//src:win_sys_libs",
  ]
  deps = [ ":cli" ]
}
