# The version string is commit-dependent, so it lives alone in one
# generated translation unit. It is an action rather than a gen-time
# write_file: ninja reruns the script when a compiler source changes, so
# editing a source without a new commit changes the version and, with
# it, the build cache key. An unchanged version leaves the file's
# timestamp alone and nothing rebuilds.
action("version_cc") {
  script = "//tools/version.py"

  # Inputs, not sources: ninja watches them for changes, but gn check must
  # not think the compiler's headers belong to this action.
  inputs = compiler_version_sources
  outputs = [ "$target_gen_dir/version.cc" ]
  args = [
    project_version,
    "--output",
    rebase_path(outputs[0], root_build_dir),
  ]
}

source_set("cli") {
  sources = [
    "$target_gen_dir/version.cc",
    "build_command.cc",
    "build_command.h",
    "build_progress.cc",
    "build_progress.h",
    "check_command.cc",
    "check_command.h",
    "cli_config.cc",
    "cli_config.h",
    "cli_main.cc",
    "cli_main.h",
    "compile_command.cc",
    "compile_command.h",
    "converters.cc",
    "converters.h",
    "duration.cc",
    "duration.h",
    "fmt_command.cc",
    "fmt_command.h",
    "init_command.cc",
    "init_command.h",
    "init_handler.cc",
    "init_handler.h",
    "lint_command.cc",
    "lint_command.h",
    "logger.cc",
    "logger.h",
    "lsp_command.cc",
    "lsp_command.h",
    "new_command.cc",
    "new_command.h",
    "output.cc",
    "output.h",
    "parse_args.cc",
    "parse_args.h",
    "parse_output.cc",
    "parse_output.h",
    "result_code.cc",
    "result_code.h",
    "run_command.cc",
    "run_command.h",
    "suggest.cc",
    "suggest.h",
    "test_command.cc",
    "test_command.h",
    "test_output.cc",
    "test_output.h",
    "trace.cc",
    "trace.h",
    "trace_report.cc",
    "trace_report.h",
    "usage.cc",
    "usage.h",
    "validate.cc",
    "validate.h",
    "version.h",
  ]
  deps = [
    ":version_cc",
    "//src/fmt:alcy_fmt",
    "//src/i18n",
    "//src/linter",
    "//src/lsp",
    "//src/pipeline",
    "//src/tcp",
    "//src/testgen",
  ]
  defines = [ "ALCY_PROJECT_NAME=\"$project_name\"" ]

  configs += [
    "//src:alcy_config",
    "//src:win_sys_libs",
  ]

  # Public: cli headers include compiler and third-party headers, so
  # dependents need the same include paths (private deps would not forward
  # them): the compiler and third-party headers cli exposes must reach
  # every target that includes a cli header.
  public_deps = [ "//src:alcy_lib" ]
}

executable("alcy") {
  sources = [ "main.cc" ]

  configs += [
    "//src:alcy_config",
    "//src:win_stack_reserve",
    "//src:win_sys_libs",
  ]
  deps = [ ":cli" ]
}
