source_set("cli") {
  sources = [
    "build_command.cc",
    "build_command.h",
    "check_command.cc",
    "check_command.h",
    "cli_config.h",
    "cli_main.cc",
    "cli_main.h",
    "converters.h",
    "init_handler.cc",
    "init_handler.h",
    "new_command.cc",
    "new_command.h",
    "parse_args.cc",
    "parse_args.h",
    "parse_output.cc",
    "parse_output.h",
    "result_code.h",
  ]
  deps = [ "//src/pipeline" ]
  defines = [
    "ALCY_PROJECT_NAME=\"$project_name\"",
    "ALCY_PROJECT_VERSION=\"$project_version\"",
    "ALCY_COMMAND_ABOUT=\"$command_about\"",
  ]

  configs += [
    "//src:alcy_config",
    "//src:win_sys_libs",
  ]

  # Public: cli headers include compiler and third-party headers, so
  # dependents need the same include paths (private deps would not forward
  # them, breaking both compilation and gn check of dependents).
  public_deps = [ "//src:alcy_lib" ]
}

executable("alcy") {
  sources = [ "main.cc" ]

  configs += [
    "//src:alcy_config",
    "//src:win_sys_libs",
  ]
  deps = [ ":cli" ]
}
