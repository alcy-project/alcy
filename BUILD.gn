group("default") {
  deps = [ "//compiler:alcy" ]
}

group("tests") {
  deps = [ "//compiler/tests" ]
}

group("benchmarks") {
  deps = [ "//compiler/benchmarks" ]
}

# The playground's host API. On a wasm build this is the loadable
# artifact (`alcy_playground.js`/`.wasm`); elsewhere it is the library
# itself, so the API still compiles and its tests still run.
group("playground") {
  deps = [ "//compiler/playground" ]
  if (is_wasm) {
    deps += [ "//compiler/playground:alcy_playground" ]
  }
}

# Fuzz targets are a development tool and are not part of `all`: they
# need libFuzzer, and a normal build should not pay for them. Build them
# with `./tools/build.py --target=fuzz --args=is_fuzz=true`.
group("fuzz") {
  testonly = true
  deps = [ "//compiler/fuzz" ]
}

group("all") {
  deps = [
    ":benchmarks",
    ":default",
    ":tests",
  ]
}
