group("default") {
  deps = [ "//src:alcy" ]
}

group("tests") {
  deps = [ "//src/tests" ]
}

group("benchmarks") {
  deps = [ "//src/benchmarks" ]
}

# The compile-time evaluator's census driver: a development tool the
# checks drive, not a command a program uses.
group("census") {
  deps = [ "//src/census:comp_census" ]
}

# The playground's host API. On a wasm build this is the loadable
# artifact (`alcy_playground.js`/`.wasm`); elsewhere it is the library
# itself, so the API still compiles and its tests still run.
group("playground") {
  deps = [ "//src/playground" ]
  if (is_wasm) {
    deps += [ "//src/playground:alcy_playground" ]
  }
}

# Fuzz targets are a development tool and are not part of `all`: they
# need libFuzzer, and a normal build should not pay for them. Build them
# with `./tools/build.py --target=fuzz --args=is_fuzz=true`.
# The site builder: a development tool the site checks drive, like the
# census driver. It is not part of `default` or `all` - the wasm build
# of `all` has no use for a host page generator - so the site workflow
# builds it by name.
group("docsite") {
  deps = [ "//src/docsite" ]
}

group("fuzz") {
  testonly = true
  deps = [ "//src/fuzz" ]
}

group("all") {
  deps = [
    ":benchmarks",
    ":census",
    ":default",
    ":tests",
    "//src/linter",
  ]
}
