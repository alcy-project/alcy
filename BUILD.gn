group("default") {
  deps = [ "//compiler:alcy" ]
}

group("tests") {
  deps = [ "//compiler/tests" ]
}

group("benchmarks") {
  deps = [ "//compiler/benchmarks" ]
}

# Fuzz targets are a development tool and are not part of `all`: they
# need libFuzzer, and a normal build should not pay for them. Build them
# with `./tools/build.py --target=fuzz --args=is_fuzz=true`.
group("fuzz") {
  testonly = true
  deps = [ "//compiler/fuzz" ]
}

group("all") {
  deps = [
    ":benchmarks",
    ":default",
    ":tests",
  ]
}
