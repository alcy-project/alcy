# The formatter is a module beside the compiler rather than a stage inside
# it: it reads source for people, not for the pipeline, and the compiler
# never depends on it. Its headers are included as "fmt/...", so the
# repository root is on the include path for the target and for everything
# that depends on it. The vendored formatting library owns the flat
# "fmt/<name>.h" spellings it ships (args, base, chrono, color, compile,
# core, enum, format, format-inl, os, ostream, printf, ranges, std,
# xchar); a file under fmt/ never takes one of those names, so the two
# "fmt/..." prefixes cannot meet.
config("fmt_config") {
  include_dirs = [
    "//",
    "//compiler",
  ]
}

source_set("alcy_fmt") {
  sources = [
    "cst.cc",
    "cst.h",
    "doc.cc",
    "doc.h",
    "formatter.cc",
    "formatter.h",
    "lex.cc",
    "lex.h",
  ]
  deps = [
    "//compiler:base_modules",
    "//compiler/diag",
    "//compiler/i18n",
    "//compiler/lexer",
    "//compiler/source",
  ]
  public_configs = [ ":fmt_config" ]
}
